# Copy to .env and fill in. The bot reads either KALSHI_PRIVATE_KEY_PATH OR
# KALSHI_PRIVATE_KEY_PEM (inline, with literal \n line breaks).

KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# KALSHI_PRIVATE_KEY_PEM=

POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional discovery provider for cross-venue search:
ODDPOOL_API_KEY=

